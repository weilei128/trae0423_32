{"remainingRequest":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/src/views/Verify.vue?vue&type=script&lang=js","dependencies":[{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/src/views/Verify.vue","mtime":1778306507619},{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/cache-loader/dist/cjs.js","mtime":1778298853536},{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/babel-loader/lib/index.js","mtime":1778298853778},{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/cache-loader/dist/cjs.js","mtime":1778298853536},{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/vue-loader/lib/index.js","mtime":1778298853858}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Verify.vue"],"names":[],"mappings":";AA0GA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Verify.vue","sourceRoot":"src/views","sourcesContent":["<template>\n  <div class=\"page-container\">\n    <div class=\"page-header\">\n      <h2 class=\"page-title\">取票核销</h2>\n    </div>\n\n    <el-row :gutter=\"20\">\n      <el-col :span=\"12\">\n        <el-card>\n          <div slot=\"header\">\n            <span>核销取票</span>\n          </div>\n          <el-form :model=\"verifyForm\" label-width=\"80px\">\n            <el-form-item label=\"订单号\">\n              <el-input v-model=\"verifyForm.orderNo\" placeholder=\"请输入订单号或扫码\" />\n            </el-form-item>\n            <el-form-item label=\"核销码\">\n              <el-input v-model=\"verifyForm.qrCode\" placeholder=\"请输入二维码内容\" />\n            </el-form-item>\n            <el-button type=\"primary\" @click=\"verifyOrder\" style=\"width: 100%;\">确认核销</el-button>\n          </el-form>\n        </el-card>\n\n        <el-card class=\"mt-20\">\n          <div slot=\"header\">\n            <span>查询订单</span>\n          </div>\n          <el-form label-width=\"80px\">\n            <el-form-item label=\"手机号\">\n              <el-input v-model=\"queryPhone\" placeholder=\"请输入手机号查询订单\" />\n              <el-button type=\"primary\" style=\"margin-top: 10px;\" @click=\"queryOrders\">查询</el-button>\n            </el-form-item>\n          </el-form>\n\n          <el-table v-if=\"customerOrders.length > 0\" :data=\"customerOrders\" border>\n            <el-table-column prop=\"orderNo\" label=\"订单号\" width=\"200\" />\n            <el-table-column label=\"影片\">\n              <template slot-scope=\"scope\">\n                {{ getScheduleMovieTitle(scope.row) }}\n              </template>\n            </el-table-column>\n            <el-table-column label=\"座位\">\n              <template slot-scope=\"scope\">\n                {{ formatSeats(scope.row.seats) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"status\" label=\"状态\">\n              <template slot-scope=\"scope\">\n                <el-tag :type=\"getStatusType(scope.row.status)\">{{ scope.row.status }}</el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column label=\"核销状态\">\n              <template slot-scope=\"scope\">\n                <el-tag :type=\"scope.row.isVerified ? 'success' : 'warning'\">\n                  {{ scope.row.isVerified ? '已核销' : '未核销' }}\n                </el-tag>\n              </template>\n            </el-table-column>\n          </el-table>\n          <el-empty v-else-if=\"queryPhone && queried\" description=\"暂无订单\" />\n        </el-card>\n      </el-col>\n\n      <el-col :span=\"12\">\n        <el-card v-if=\"verifiedOrder\">\n          <div slot=\"header\">\n            <span style=\"color: #67C23A; font-weight: 600;\">\n              <i class=\"el-icon-success\"></i> 核销成功\n            </span>\n          </div>\n          <el-descriptions :column=\"1\" border>\n            <el-descriptions-item label=\"订单号\">{{ verifiedOrder.orderNo }}</el-descriptions-item>\n            <el-descriptions-item label=\"影片\">{{ getOrderMovieTitle(verifiedOrder) }}</el-descriptions-item>\n            <el-descriptions-item label=\"影厅\">{{ getOrderHallName(verifiedOrder) }}</el-descriptions-item>\n            <el-descriptions-item label=\"场次\">{{ getOrderStartTime(verifiedOrder) }}</el-descriptions-item>\n            <el-descriptions-item label=\"座位\">{{ formatSeats(verifiedOrder.seats) }}</el-descriptions-item>\n            <el-descriptions-item label=\"购票人\">{{ verifiedOrder.customerName }} ({{ verifiedOrder.customerPhone }})</el-descriptions-item>\n            <el-descriptions-item label=\"核销时间\">{{ formatDateTime(verifiedOrder.verifiedAt) }}</el-descriptions-item>\n          </el-descriptions>\n        </el-card>\n\n        <el-card v-else>\n          <div slot=\"header\">\n            <span>核销说明</span>\n          </div>\n          <el-timeline>\n            <el-timeline-item timestamp=\"步骤1\" placement=\"top\">\n              输入订单号或扫描二维码\n            </el-timeline-item>\n            <el-timeline-item timestamp=\"步骤2\" placement=\"top\">\n              点击确认核销按钮\n            </el-timeline-item>\n            <el-timeline-item timestamp=\"步骤3\" placement=\"top\">\n              系统验证订单有效性\n            </el-timeline-item>\n            <el-timeline-item timestamp=\"步骤4\" placement=\"top\">\n              核销成功，打印电影票\n            </el-timeline-item>\n          </el-timeline>\n        </el-card>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script>\nimport { verifyOrder, getOrdersByPhone } from '@/api/order'\nimport dayjs from 'dayjs'\n\nexport default {\n  name: 'Verify',\n  data() {\n    return {\n      verifyForm: {\n        orderNo: '',\n        qrCode: ''\n      },\n      queryPhone: '',\n      queried: false,\n      customerOrders: [],\n      verifiedOrder: null\n    }\n  },\n  methods: {\n    formatDateTime(dt) {\n      if (!dt) return ''\n      return dayjs(dt).format('YYYY-MM-DD HH:mm')\n    },\n    getScheduleMovieTitle(row) {\n      if (!row || !row.schedule) return ''\n      return row.schedule.movie ? row.schedule.movie.title : ''\n    },\n    getOrderMovieTitle(order) {\n      if (!order || !order.schedule) return ''\n      return order.schedule.movie ? order.schedule.movie.title : ''\n    },\n    getOrderHallName(order) {\n      if (!order || !order.schedule) return ''\n      return order.schedule.hall ? order.schedule.hall.name : ''\n    },\n    getOrderStartTime(order) {\n      if (!order || !order.schedule) return ''\n      return this.formatDateTime(order.schedule.startTime)\n    },\n    formatSeats(seatsJson) {\n      try {\n        const seats = JSON.parse(seatsJson)\n        return seats.map(s => {\n          const [row, seat] = s.split('-')\n          return row + '排' + seat + '座'\n        }).join(', ')\n      } catch {\n        return seatsJson\n      }\n    },\n    getStatusType(status) {\n      if (status === '已支付') return 'success'\n      if (status === '待支付') return 'warning'\n      return 'info'\n    },\n    async verifyOrder() {\n      if (!this.verifyForm.orderNo && !this.verifyForm.qrCode) {\n        this.$message.warning('请输入订单号或核销码')\n        return\n      }\n\n      try {\n        const verifyCode = this.verifyForm.qrCode || this.verifyForm.orderNo\n        this.verifiedOrder = await verifyOrder(verifyCode)\n        this.$message.success('核销成功！')\n      } catch (error) {\n        console.error('核销失败:', error)\n      }\n    },\n    async queryOrders() {\n      if (!this.queryPhone) {\n        this.$message.warning('请输入手机号')\n        return\n      }\n\n      try {\n        this.queried = true\n        this.customerOrders = await getOrdersByPhone(this.queryPhone)\n      } catch (error) {\n        console.error('查询订单失败:', error)\n        this.customerOrders = []\n      }\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.mt-20 {\n  margin-top: 20px;\n}\n</style>\n"]}]}