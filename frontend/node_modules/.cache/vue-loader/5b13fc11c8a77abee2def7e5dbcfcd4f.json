{"remainingRequest":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/src/views/Schedules.vue?vue&type=script&lang=js","dependencies":[{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/src/views/Schedules.vue","mtime":1778306341469},{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/cache-loader/dist/cjs.js","mtime":1778298853536},{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/babel-loader/lib/index.js","mtime":1778298853778},{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/cache-loader/dist/cjs.js","mtime":1778298853536},{"path":"/Users/weilei/Desktop/traeTest/trae0423/trae0423_32/trae0423_32/frontend/node_modules/vue-loader/lib/index.js","mtime":1778298853858}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Schedules.vue"],"names":[],"mappings":";AAsHA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Schedules.vue","sourceRoot":"src/views","sourcesContent":["<template>\n  <div class=\"page-container\">\n    <div class=\"page-header\">\n      <h2 class=\"page-title\">排片管理</h2>\n      <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"handleAdd\">新增排片</el-button>\n    </div>\n\n    <div class=\"search-bar\">\n      <el-select v-model=\"filterHall\" placeholder=\"按影厅筛选\" style=\"width: 200px; margin-right: 10px;\" clearable @change=\"fetchScheduleList\">\n        <el-option\n          v-for=\"hall in hallList\"\n          :key=\"hall.id\"\n          :label=\"hall.name\"\n          :value=\"hall.id\"\n        />\n      </el-select>\n      <el-select v-model=\"filterMovie\" placeholder=\"按影片筛选\" style=\"width: 200px;\" clearable @change=\"fetchScheduleList\">\n        <el-option\n          v-for=\"movie in movieList\"\n          :key=\"movie.id\"\n          :label=\"movie.title\"\n          :value=\"movie.id\"\n        />\n      </el-select>\n    </div>\n\n    <el-table :data=\"scheduleList\" border stripe>\n      <el-table-column prop=\"id\" label=\"ID\" width=\"80\" />\n      <el-table-column label=\"影片\">\n        <template slot-scope=\"scope\">\n          {{ getMovieTitle(scope.row) }}\n        </template>\n      </el-table-column>\n      <el-table-column label=\"影厅\">\n        <template slot-scope=\"scope\">\n          {{ getHallInfo(scope.row) }}\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"timeSlot\" label=\"时段\" width=\"80\">\n        <template slot-scope=\"scope\">\n          <el-tag>{{ scope.row.timeSlot }}</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"开始时间\">\n        <template slot-scope=\"scope\">\n          {{ formatDateTime(scope.row.startTime) }}\n        </template>\n      </el-table-column>\n      <el-table-column label=\"结束时间\">\n        <template slot-scope=\"scope\">\n          {{ formatDateTime(scope.row.endTime) }}\n        </template>\n      </el-table-column>\n      <el-table-column label=\"票价\">\n        <template slot-scope=\"scope\">\n          ¥{{ scope.row.price }}\n        </template>\n      </el-table-column>\n      <el-table-column label=\"状态\" width=\"80\">\n        <template slot-scope=\"scope\">\n          <el-tag :type=\"scope.row.isActive ? 'success' : 'info'\">\n            {{ scope.row.isActive ? '正常' : '已取消' }}\n          </el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"操作\" width=\"150\">\n        <template slot-scope=\"scope\">\n          <el-button size=\"small\" type=\"danger\" @click=\"handleDelete(scope.row)\">取消</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <el-dialog title=\"新增排片\" :visible.sync=\"dialogVisible\" width=\"600px\">\n      <el-form :model=\"form\" :rules=\"rules\" ref=\"form\" label-width=\"100px\">\n        <el-form-item label=\"选择影片\" prop=\"movieId\">\n          <el-select v-model=\"form.movieId\" placeholder=\"请选择影片\" style=\"width: 100%;\" @change=\"onMovieChange\">\n            <el-option\n              v-for=\"movie in movieList\"\n              :key=\"movie.id\"\n              :label=\"movie.title + ' (' + movie.duration + '分钟)'\"\n              :value=\"movie.id\"\n            />\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"选择影厅\" prop=\"hallId\">\n          <el-select v-model=\"form.hallId\" placeholder=\"请选择影厅\" style=\"width: 100%;\" @change=\"onHallChange\">\n            <el-option\n              v-for=\"hall in hallList\"\n              :key=\"hall.id\"\n              :label=\"hall.name + ' (' + hall.type + ')'\"\n              :value=\"hall.id\"\n            />\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"开始时间\" prop=\"startTime\">\n          <el-date-picker\n            v-model=\"form.startTime\"\n            type=\"datetime\"\n            placeholder=\"选择开始时间\"\n            style=\"width: 100%;\"\n            format=\"yyyy-MM-dd HH:mm:ss\"\n            value-format=\"yyyy-MM-dd'T'HH:mm:ss\"\n          />\n        </el-form-item>\n        <el-form-item label=\"票价\">\n          <el-input-number v-model=\"form.price\" :min=\"0\" :step=\"1\" />\n          <span style=\"margin-left: 10px; color: #909399;\">（留空将自动计算）</span>\n        </el-form-item>\n      </el-form>\n      <div slot=\"footer\">\n        <el-button @click=\"dialogVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"handleSubmit\">确定</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { getScheduleList, getSchedulesByMovie, getSchedulesByHall, createSchedule, deleteSchedule } from '@/api/schedule'\nimport { getMovieList } from '@/api/movie'\nimport { getHallList } from '@/api/hall'\nimport dayjs from 'dayjs'\n\nexport default {\n  name: 'Schedules',\n  data() {\n    return {\n      scheduleList: [],\n      movieList: [],\n      hallList: [],\n      filterHall: '',\n      filterMovie: '',\n      dialogVisible: false,\n      form: {\n        movieId: '',\n        hallId: '',\n        startTime: '',\n        price: null\n      },\n      selectedMovie: null,\n      selectedHall: null,\n      rules: {\n        movieId: [{ required: true, message: '请选择影片', trigger: 'change' }],\n        hallId: [{ required: true, message: '请选择影厅', trigger: 'change' }],\n        startTime: [{ required: true, message: '请选择开始时间', trigger: 'change' }]\n      }\n    }\n  },\n  mounted() {\n    this.fetchMovieList()\n    this.fetchHallList()\n    this.fetchScheduleList()\n  },\n  methods: {\n    formatDateTime(dt) {\n      if (!dt) return ''\n      return dayjs(dt).format('YYYY-MM-DD HH:mm')\n    },\n    getMovieTitle(row) {\n      return row.movie ? row.movie.title : ''\n    },\n    getHallInfo(row) {\n      return row.hall ? row.hall.name + ' (' + row.hall.type + ')' : ''\n    },\n    async fetchMovieList() {\n      try {\n        this.movieList = await getMovieList()\n      } catch (error) {\n        console.error('获取影片列表失败:', error)\n      }\n    },\n    async fetchHallList() {\n      try {\n        this.hallList = await getHallList()\n      } catch (error) {\n        console.error('获取影厅列表失败:', error)\n      }\n    },\n    async fetchScheduleList() {\n      try {\n        if (this.filterMovie) {\n          this.scheduleList = await getSchedulesByMovie(this.filterMovie)\n        } else if (this.filterHall) {\n          this.scheduleList = await getSchedulesByHall(this.filterHall)\n        } else {\n          this.scheduleList = await getScheduleList()\n        }\n      } catch (error) {\n        console.error('获取排片列表失败:', error)\n      }\n    },\n    onMovieChange(movieId) {\n      this.selectedMovie = this.movieList.find(m => m.id === movieId)\n    },\n    onHallChange(hallId) {\n      this.selectedHall = this.hallList.find(h => h.id === hallId)\n    },\n    handleAdd() {\n      this.form = {\n        movieId: '',\n        hallId: '',\n        startTime: '',\n        price: null\n      }\n      this.dialogVisible = true\n    },\n    async handleSubmit() {\n      try {\n        await this.$refs.form.validate(async (valid) => {\n          if (valid) {\n            const data = {\n              movieId: this.form.movieId,\n              hallId: this.form.hallId,\n              startTime: this.form.startTime\n            }\n            if (this.form.price) {\n              data.price = this.form.price\n            }\n            await createSchedule(data)\n            this.$message.success('排片成功')\n            this.dialogVisible = false\n            this.fetchScheduleList()\n          }\n        })\n      } catch (error) {\n        console.error('排片失败:', error)\n      }\n    },\n    handleDelete(row) {\n      this.$confirm('确定要取消该排片吗?', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          await deleteSchedule(row.id)\n          this.$message.success('取消成功')\n          this.fetchScheduleList()\n        } catch (error) {\n          console.error('取消排片失败:', error)\n        }\n      }).catch(() => {})\n    }\n  }\n}\n</script>\n"]}]}