iv>\n            <div class=\"stat-value\">¥{{ formatNumber(dailyReport.totalRevenue) }}</div>\n          </div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card class=\"stat-card\">\n          <div class=\"stat-icon green\">\n            <i class=\"el-icon-tickets\"></i>\n          </div>\n          <div class=\"stat-info\">\n            <div class=\"stat-label\">今日售票数</div>\n            <div class=\"stat-value\">{{ dailyReport.totalTickets || 0 }} 张</div>\n          </div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card class=\"stat-card\">\n          <div class=\"stat-icon orange\">\n            <i class=\"el-icon-pie-chart\"></i>\n          </div>\n          <div class=\"stat-info\">\n            <div class=\"stat-label\">今日上座率</div>\n            <div class=\"stat-value\">{{ formatRate(dailyReport.occupancyRate) }}%</div>\n          </div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card class=\"stat-card\">\n          <div class=\"stat-icon purple\">\n            <i class=\"el-icon-date\"></i>\n          </div>\n          <div class=\"stat-info\">\n            <div class=\"stat-label\">本周营业额</div>\n            <div class=\"stat-value\">¥{{ formatNumber(weeklyReport.totalWeeklyRevenue) }}</div>\n          </div>\n        </el-card>\n      </el-col>\n    </el-row>\n\n    <el-card class=\"mt-20\">\n      <div slot=\"header\">\n        <span>今日影片票房排行</span>\n      </div>\n      <el-table :data=\"dailyReport.movieStats || []\" border>\n        <el-table-column label=\"排名\" type=\"index\" width=\"80\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <span v-if=\"scope.$index < 3\" class=\"rank-badge\" :class=\"'rank-' + (scope.$index + 1)\">\n              {{ scope.$index + 1 }}\n            </span>\n            <span v-else>{{ scope.$index + 1 }}</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"movieName\" label=\"影片名称\" />\n        <el-table-column prop=\"tickets\" label=\"售票数\" align=\"center\" />\n        <el-table-column label=\"票房\">\n          <template slot-scope=\"scope\">\n            ¥{{ formatNumber(scope.row.revenue) }}\n          </template>\n        </el-table-column>\n      </el-table>\n    </el-card>\n\n    <el-card class=\"mt-20\">\n      <div slot=\"header\">\n        <span>近7天营业额趋势</span>\n      </div>\n      <div class=\"trend-chart\">\n        <el-table :data=\"weeklyReport.dailyReports || []\" border>\n          <el-table-column prop=\"date\" label=\"日期\" width=\"150\" />\n          <el-table-column label=\"营业额\">\n            <template slot-scope=\"scope\">\n              ¥{{ formatNumber(scope.row.totalRevenue) }}\n            </template>\n          </el-table-column>\n          <el-table-column label=\"售票数\">\n            <template slot-scope=\"scope\">\n              {{ scope.row.totalTickets }} 张\n            </template>\n          </el-table-column>\n          <el-table-column label=\"上座率\">\n            <template slot-scope=\"scope\">\n              {{ formatRate(scope.row.occupancyRate) }}%\n            </template>\n          </el-table-column>\n        </el-table>\n      </div>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport { getDailyReport, getWeeklyReport } from '@/api/report'\n\nexport default {\n  name: 'Dashboard',\n  data() {\n    return {\n      dailyReport: {},\n      weeklyReport: {}\n    }\n  },\n  mounted() {\n    this.fetchDailyReport()\n    this.fetchWeeklyReport()\n  },\n  methods: {\n    formatNumber(val) {\n      if (val == null || isNaN(val)) return '0.00'\n      return val.toFixed(2)\n    },\n    formatRate(val) {\n      if (val == null || isNaN(val)) return '0'\n      return val.toFixed(1)\n    },\n    async fetchDailyReport() {\n      try {\n        this.dailyReport = await getDailyReport()\n      } catch (error) {\n        console.error('获取日报表失败:', error)\n      }\n    },\n    async fetchWeeklyReport() {\n      try {\n        this.weeklyReport = await getWeeklyReport()\n      } catch (error) {\n        console.error('获取周报表失败:', error)\n      }\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.dashboard {\n  padding: 10px;\n}\n\n.stat-card {\n  .el-card__body {\n    display: flex;\n    align-items: center;\n    padding: 20px;\n  }\n}\n\n.stat-icon {\n  width: 60px;\n  height: 60px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-right: 20px;\n\n  i {\n    font-size: 30px;\n    color: #fff;\n  }\n\n  &.blue {\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n  }\n\n  &.green {\n    background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);\n  }\n\n  &.orange {\n    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n  }\n\n  &.purple {\n    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);\n  }\n}\n\n.stat-info {\n  .stat-label {\n    color: #909399;\n    font-size: 14px;\n    margin-bottom: 5px;\n  }\n\n  .stat-value {\n    font-size: 24px;\n    font-weight: 600;\n    color: #303133;\n  }\n}\n\n.mt-20 {\n  margin-top: 20px;\n}\n\n.rank-badge {\n  display: inline-block;\n  width: 24px;\n  height: 24px;\n  line-height: 24px;\n  border-radius: 50%;\n  color: #fff;\n  font-weight: 600;\n\n  &.rank-1 {\n    background-color: #ffd700;\n  }\n\n  &.rank-2 {\n    background-color: #c0c0c0;\n  }\n\n  &.rank-3 {\n    background-color: #cd7f32;\n  }\n}\n</style>\n"],"mappings":"AAyGA,SAAAA,cAAA,EAAAC,eAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,WAAA;MACAC,YAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;IACA,KAAAC,iBAAA;EACA;EACAC,OAAA;IACAC,aAAAC,GAAA;MACA,IAAAA,GAAA,YAAAC,KAAA,CAAAD,GAAA;MACA,OAAAA,GAAA,CAAAE,OAAA;IACA;IACAC,WAAAH,GAAA;MACA,IAAAA,GAAA,YAAAC,KAAA,CAAAD,GAAA;MACA,OAAAA,GAAA,CAAAE,OAAA;IACA;IACA,MAAAN,iBAAA;MACA;QACA,KAAAH,WAAA,SAAAJ,cAAA;MACA,SAAAe,KAAA;QACAC,OAAA,CAAAD,KAAA,aAAAA,KAAA;MACA;IACA;IACA,MAAAP,kBAAA;MACA;QACA,KAAAH,YAAA,SAAAJ,eAAA;MACA,SA